# Flask
FLASK_APP=wsgi.py
FLASK_ENV=development

# Admin account - read by `flask seed-admin` (run with no flags once these are
# set: `flask seed-admin`). Safe to re-run any time - updates the existing
# admin's password/name rather than duplicating. Change ADMIN_PASSWORD to
# something only you know before running it for real.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-before-running-seed-admin
ADMIN_NAME=Admin

# APP_ENV=production makes the app refuse to start if SECRET_KEY/JWT_SECRET_KEY
# are still their dev defaults below (see app/__init__.py). Leave unset (or
# "development") locally; set APP_ENV=production on any real deployment,
# alongside real random secrets - e.g. `python3 -c "import secrets; print(secrets.token_hex(32))"`
# APP_ENV=production
SECRET_KEY=dev-secret-key-change-me
JWT_SECRET_KEY=dev-jwt-secret-key-change-me

# Rate-limit storage: fine as-is (in-process memory) for local dev or a
# single-process deployment. Running multiple worker processes in production
# needs a shared backend or each worker enforces its own separate limit -
# point this at Redis then, e.g. RATELIMIT_STORAGE_URI=redis://localhost:6379
# RATELIMIT_STORAGE_URI=memory://

# Database. Leave unset to use SQLite at backend/instance/app.db (the
# default). In production, point at Postgres instead, e.g.
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# DATABASE_URL=

# CORS - comma-separated list of allowed frontend/admin origins
CORS_ORIGINS=http://localhost:8443,http://localhost:5174,http://127.0.0.1:8443,http://127.0.0.1:5174

# Payment methods accepted at checkout - comma-separated. eSewa/Stripe are
# fully built (see below) but OFF for initial launch; add them back here
# (e.g. "cod,esewa,stripe") once ready to re-enable, on both this env var
# AND frontend/src/pages/Checkout.tsx's ENABLED_METHODS array (frontend
# only decides what button to show - this is the real server-side gate).
ENABLED_PAYMENT_METHODS=cod

# eSewa (values below are eSewa's publicly documented UAT/sandbox test
# merchant credentials - safe to use for development as-is. Before going
# live: get real merchant credentials from https://merchant.esewa.com.np
# and swap BOTH URLs below to their production hosts -
# ESEWA_INITIATE_URL=https://epay.esewa.com.np/api/epay/main/v2/form
# ESEWA_STATUS_URL=https://esewa.com.np/api/epay/transaction/status/
ESEWA_MERCHANT_CODE=EPAYTEST
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q
ESEWA_INITIATE_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form
ESEWA_STATUS_URL=https://rc.esewa.com.np/api/epay/transaction/status/

# Stripe - unlike eSewa, there is no shared public test key. Sign up free at
# https://dashboard.stripe.com/register (any country - test mode needs no
# business verification), then copy your test "Secret key" (starts sk_test_)
# from https://dashboard.stripe.com/test/apikeys and paste it below.
# Payment initiation will fail with a clear error until this is set.
# NOTE: Stripe does not support Nepal-registered businesses for LIVE payouts -
# going live requires a business entity in a Stripe-supported country (see
# CLAUDE.md's "Payment gateways" section). Test mode works regardless.
STRIPE_SECRET_KEY=
